# Aliases
# VNC_PASSWORD is kept as a non-exported shell variable and passed only to the viewer
alias cernvnc='VNC_PASSWORD="$VNC_PASSWORD" /Applications/TigerVNC\ Viewer\ 1.14.0.app/Contents/MacOS/TigerVNC\ Viewer micgate02.cern.ch:12 -via lxtunnel'
alias vncgivepass='read -s "?VNC password:" VNC_PASSWORD; echo'

# Kerberos
if ! klist 2> /dev/null | grep -q "mandorno"; then
    echo "Setting up Kerberos token..."
    kinit mandorno
    klist
fi
